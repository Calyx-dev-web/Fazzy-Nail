rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null;
    }

    // Publicly readable website content; only signed-in admin can write/delete
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(settingId);
    }

    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(serviceId);
    }

    match /gallery/{galleryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(galleryId);
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId);
      allow update, delete: if isAdmin() && isValidId(reviewId);
    }

    // Visitors can submit bookings & inquiries; only signed-in admin can read/manage
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId);
      allow get, list, update, delete: if isAdmin() && isValidId(bookingId);
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId);
      allow get, list, update, delete: if isAdmin() && isValidId(inquiryId);
    }

    // Private admin-only collections
    match /admins/{adminId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(adminId);
    }

    match /customers/{customerId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(customerId);
    }

    match /invoices/{invoiceId} {
      allow get, list, create, update, delete: if isAdmin() && isValidId(invoiceId);
    }
  }
}
